{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$(git rev-parse --show-toplevel)/.githooks/pre-commit-review.sh\"",
            "timeout": 180,
            "statusMessage": "Running pre-commit code review..."
          }
        ]
      }
    ]
  }
}


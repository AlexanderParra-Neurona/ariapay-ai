#!/usr/bin/env bash
# git pre-commit hook: runs the same headless code review used by Claude
# Code's PreToolUse hook, so `git commit` from a plain terminal is covered
# too. Enable with: git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec "$REPO_ROOT/.claude/hooks/pre-commit-review.sh"

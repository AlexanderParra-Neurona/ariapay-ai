API_URL=changeme
ARIAPAY_API_URL=changeme

# Host port app binds to on 127.0.0.1 (change if 8000 already used on this machine)
APP_PORT=8000

# Tags traces (e.g. staging-pilot, production) so environments don't mix in dashboards
APP_ENV=development

LOGIN_PHONE_NUMBER=changeme
LOGIN_COUNTRY_CODE=+62
LOGIN_PASSWORD=changeme
LOGIN_PASSCODE=changeme

OLLAMA_URL=changeme
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
OLLAMA_EMBED_DIM=4096

DEEPINFRA_API_TOKEN=changeme
DEEPINFRA_CHAT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
DEEPINFRA_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
DEEPINFRA_EMBED_DIM=4096

QDRANT_URL=changeme
QDRANT_API_KEY=changeme
QDRANT_COLLECTION=ariapay_docs

CUSTODIA_INGEST_URL=http://host.docker.internal:8000/v1/traces
CUSTODIA_API_KEY=changeme
CUSTODIA_SERVICE_NAME=ariabot